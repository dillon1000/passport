/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "passport",
	"main": "worker/index.ts",
	"compatibility_date": "2026-06-14",
	"workers_dev": false,
	"keep_vars": true,
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"routes": [
		{
			"pattern": "passport.dillon.network",
			"zone_name": "dillon.network",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://passport.dillon.network",
		"TRUSTED_ORIGINS": "https://passport.dillon.network",
		"EMAIL_FROM": "Passport <passport@mail.11011.dev>",
		"ADMIN_EMAILS": "dillon@dillonring.com",
		"BRAND_NAME": "Passport",
		"BRAND_ABBREVIATION": "PP",
		"BRAND_DESCRIPTOR": "All together now.",
		"BRAND_CAPABILITIES": "Copyright 2026 Dillon Ring",
		"AGENT_AUTH_PROVIDER_DESCRIPTION": "All together now.",
		"AGENT_AUTH_PROVIDER_NAME": "Passport",
		"AZURE_COMMUNICATION_SMS_FROM": "+18335472995",
		"CAPTCHA_PROVIDER": "cloudflare-turnstile",
		"CAPTCHA_SITE_KEY": "0x4AAAAAADmMGKtnZUuAFX1C",
		"CAPTCHA_SITE_VERIFY_URL": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
		"DISCORD_CLIENT_ID": "1516628634276855921",
		"GITHUB_CLIENT_ID": "Ov23li3nAzZlzT5lheYm",
		"OAUTH_PROXY_PRODUCTION_URL": "https://passport.dillon.network",
		"X_CLIENT_ID": "aGx3clh6Y0pnTkJyS0d3eUhpZDg6MTpjaQ",
		"AUTH_RATE_LIMIT_ENABLED": "true",
		"AUTH_RATE_LIMIT_WINDOW_SECONDS": "60",
		"AUTH_RATE_LIMIT_MAX": "120",
		"AUTH_SENSITIVE_RATE_LIMIT_WINDOW_SECONDS": "60",
		"AUTH_SENSITIVE_RATE_LIMIT_MAX": "10",
		"ACCOUNT_LOCKOUT_ENABLED": "true",
		"ACCOUNT_LOCKOUT_THRESHOLD": "10",
		"ACCOUNT_LOCKOUT_WINDOW_SECONDS": "900",
		"ACCOUNT_LOCKOUT_COOLDOWN_SECONDS": "900",
		"STRIPE_API_VERSION": "2026-05-27.dahlia",
		"STRIPE_CREATE_CUSTOMER_ON_SIGN_UP": "true",
		"STRIPE_BILLING_REQUIRE_EMAIL_VERIFICATION": "true",
		"STRIPE_CHECKOUT_ALLOW_PROMOTION_CODES": "true",
		"STRIPE_CHECKOUT_AUTOMATIC_TAX_ENABLED": "false",
		"STRIPE_CHECKOUT_BILLING_ADDRESS_COLLECTION": "auto",
		"STRIPE_CHECKOUT_TAX_ID_COLLECTION_ENABLED": "false",
		"STRIPE_BILLING_PLANS": "[{\"name\":\"pro\",\"label\":\"Pro\",\"description\":\"Production auth and billing features.\",\"priceId\":\"price_replace_monthly\",\"annualDiscountPriceId\":\"price_replace_yearly\",\"limits\":{\"applications\":10,\"organizations\":3},\"entitlements\":[\"oauth\",\"billing\"],\"freeTrialDays\":14},{\"name\":\"team\",\"label\":\"Team\",\"description\":\"Organization billing with seat sync.\",\"priceId\":\"price_replace_team_monthly\",\"annualDiscountPriceId\":\"price_replace_team_yearly\",\"seatPriceId\":\"price_replace_team_seat\",\"limits\":{\"applications\":50,\"organizations\":10,\"members\":100},\"entitlements\":[\"oauth\",\"billing\",\"organizations\",\"seats\"]}]",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "68caa3634bfa4e7fa760bdb20b88da43"
		}
	],
	"kv_namespaces": [
		{
			"binding": "AUTH_SECONDARY_STORAGE",
			"id": "a54907758dfc4a35817fd2063a2e14b8"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "PROFILE_IMAGES",
			"bucket_name": "passport-profile-images"
		},
		{
			"binding": "DATA_EXPORTS",
			"bucket_name": "passport-data-exports"
		}
	],
	"workflows": [
		{
			"name": "passport-data-export",
			"binding": "DATA_EXPORT_WORKFLOW",
			"class_name": "DataExportWorkflow"
		},
		{
			"name": "passport-webhook-delivery",
			"binding": "WEBHOOK_DELIVERY_WORKFLOW",
			"class_name": "WebhookDeliveryWorkflow"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
