{
	"name": "passport",
	"private": true,
	"version": "0.0.182",
	"description": "Standalone identity provider for Cloudflare Workers.",
	"author": "Dillon Ring <dillon@dillonring.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/dillon1000/passport.git"
	},
	"bugs": {
		"url": "https://github.com/dillon1000/passport/issues"
	},
	"homepage": "https://github.com/dillon1000/passport#readme",
	"packageManager": "pnpm@10.32.1",
	"pnpm": {
		"overrides": {
			"@esbuild-kit/core-utils>esbuild": "0.25.12"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:55432/passport vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"test": "vitest run --config vitest.config.ts",
		"db:start": "./scripts/start-db.sh",
		"db:generate": "node --env-file-if-exists=.dev.vars node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node scripts/migrate.mjs",
		"admin:promote": "node scripts/promote-admin.mjs",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@better-auth/agent-auth": "^0.6.2",
		"@better-auth/oauth-provider": "^1.7.1",
		"@better-auth/passkey": "^1.7.1",
		"@better-auth/stripe": "^1.7.1",
		"@cloudflare/kumo": "^2.12.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/rubik": "^5.3.0",
		"@hono/zod-openapi": "^1.6.1",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.0",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1",
		"better-auth": "^1.7.1",
		"cap-widget": "^0.1.57",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"hono": "^4.13.3",
		"iconoir-react": "^7.12.1",
		"nanoid": "^6.0.1",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "^6.9.2",
		"react-qr-code": "^2.2.0",
		"react-router": "^8.3.0",
		"react-turnstile": "^1.1.5",
		"sonner": "^2.0.8",
		"stripe": "^22.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.53.1",
		"@oxlint/plugins": "1.79.0",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	}
}
