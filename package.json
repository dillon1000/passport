{
	"name": "passport",
	"private": true,
	"version": "0.0.55",
	"description": "Standalone identity provider for Cloudflare Workers.",
	"author": "Dillon Ring <dillon@dillonring.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/dillon1000/passport.git"
	},
	"bugs": {
		"url": "https://github.com/dillon1000/passport/issues"
	},
	"homepage": "https://github.com/dillon1000/passport#readme",
	"type": "module",
	"scripts": {
		"dev": "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:55432/passport vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"test": "vitest run --config vitest.config.ts",
		"db:start": "./scripts/start-db.sh",
		"db:generate": "node --env-file-if-exists=.dev.vars node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node scripts/migrate.mjs",
		"admin:promote": "node scripts/promote-admin.mjs",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@better-auth/agent-auth": "^0.6.2",
		"@better-auth/oauth-provider": "^1.6.18",
		"@better-auth/passkey": "^1.6.18",
		"@fontsource-variable/geist": "^5.2.9",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.8",
		"@tailwindcss/vite": "^4.3.1",
		"better-auth": "^1.6.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"hono": "^4.12.25",
		"lucide-react": "^1.18.0",
		"postgres": "^3.4.9",
		"radix-ui": "^1.5.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-qr-code": "^2.2.0",
		"react-router": "^8.0.0",
		"react-turnstile": "^1.1.5",
		"shadcn": "^4.11.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.40.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.12.3",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12",
		"vitest": "^4.1.8",
		"wrangler": "^4.100.0"
	}
}
